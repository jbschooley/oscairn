        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "messageBytes": {
              "const": 65536
            },
            "depth": {
              "const": 32
            },
            "batch": {
              "const": 64
            },
            "parameterChanges": {
              "const": 128
            }
          },
          "required": [
            "messageBytes",
            "depth",
            "batch",
            "parameterChanges"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "server",
        "capabilities",
        "limits"
      ],
      "additionalProperties": false
