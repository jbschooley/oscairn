    "ParameterInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "defaultValue": {
          "type": "number"
        },
        "stepped": {
          "type": "boolean"
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "name",
        "minimum",
        "maximum",
        "defaultValue",
        "stepped",
        "flags"
      ],
      "additionalProperties": false
    },
    "Transport": {
      "type": "object",
      "properties": {
        "playing": {
          "type": "boolean"
        },
        "tempo": {
          "type": "number"
        },
        "beat": {
          "type": "number"
        },
        "clockSource": {
          "enum": [
            "internal",
            "midi"
          ]
        }
      },
      "required": [
        "playing",
        "tempo",
        "beat",
        "clockSource"
      ],
      "additionalProperties": false
