            "params": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "key": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "velocity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "channel": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                }
              },
              "required": [
                "on",
                "key"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "method",
            "params"
          ],
          "additionalProperties": true
        }
