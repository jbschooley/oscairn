          "required": [
            "jsonrpc",
            "method",
            "params"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "method": {
              "const": "params.set"
            },
            "params": {
              "type": "object",
              "properties": {
                "values": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ParameterValue"
                  },
                  "minItems": 1,
                  "maxItems": 128
                }
              },
              "required": [
                "values"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "method",
            "params"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "method": {
              "const": "params.text"
            },
            "params": {
              "type": "object",
              "properties": {
                "node": {
                  "$ref": "#/$defs/Node"
                },
                "param": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "node",
                "param",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "method",
            "params"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "method": {
              "const": "transport.get"
            },
            "params": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "method"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "method": {
              "const": "transport.set"
            },
            "params": {
              "type": "object",
              "properties": {
                "playing": {
                  "type": "boolean"
                },
                "tempo": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 1000
                },
                "clockSource": {
                  "enum": [
                    "internal",
                    "midi"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false,
              "minProperties": 1
            }
          },
          "required": [
            "jsonrpc",
            "method",
            "params"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "method": {
