{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oscairn control protocol 1: implemented subset",
  "description": "Complete JSON document. Byte/depth limits, duplicate-member rejection, finite double range, unique parameter addresses and queue semantics are specified in control-protocol.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Request"
      },
      "minItems": 1,
      "maxItems": 64
    },
    {
      "$ref": "#/$defs/Response"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Response"
      },
      "minItems": 1,
      "maxItems": 64
    }
  ],
  "$defs": {
    "Id": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "Node": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      ]
    },
    "ParameterAddress": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/Node"
        },
        "param": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "node",
        "param"
      ],
      "additionalProperties": false
    },
    "ParameterValue": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/Node"
        },
        "param": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "node",
        "param",
        "value"
      ],
      "additionalProperties": false
    },
    "ParameterResult": {
      "type": "object",
      "properties": {
        "node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "param": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "node",
        "param",
        "value"
      ],
      "additionalProperties": false
