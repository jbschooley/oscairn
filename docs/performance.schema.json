{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oscairn Performance version 2",
  "description": "performance.json inside a Performance folder. See performance-format.md for binary state, asset limits, plugin validation and transactional loading. Runtime node/context IDs and live voices are not persisted. Wires and parts (RFC 0011) define the graph's audio routes and note connections.",
  "type": "object",
  "properties": {
    "format": {
      "const": "oscairn.performance"
    },
    "version": {
      "const": 2
    },
    "libraries": {
      "type": "array",
      "maxItems": 4096,
      "description": "Asset libraries the nodes' sound assets come from (RFC 0009)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "transport": {
      "type": "object",
      "properties": {
        "tempo": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "clockSource": {
          "enum": [
            "internal",
            "midi"
          ]
        }
      },
      "required": [
        "tempo",
        "clockSource"
      ],
      "additionalProperties": false
    },
    "audioInputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      },
      "maxItems": 256
    },
    "audioOutputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      },
      "maxItems": 256
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 256
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Wire"
      },
      "maxItems": 4096
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      },
      "maxItems": 256
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/$defs/NodeKey"
          },
          "lane": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "to": {
            "$ref": "#/$defs/NodeKey"
          },
          "param": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "required": [
          "from",
          "lane",
          "to",
          "param"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    }
  },
  "required": [
    "format",
    "version",
    "transport",
    "audioInputs",
    "audioOutputs",
    "nodes",
    "wires",
    "parts",
    "mappings"
  ],
  "additionalProperties": false,
  "$defs": {
    "NodeKey": {
      "type": "string",
      "pattern": "^node-[0-9]{1,7}$"
    },
    "EndpointKey": {
      "oneOf": [
        {
          "$ref": "#/$defs/NodeKey"
        },
        {
          "enum": [
            "input",
            "output"
          ]
        }
      ]
    },
    "Port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "channels",
        "flags"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/NodeKey"
        },
        "name": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "plugin": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "clap",
                "lv2"
              ]
            },
            "id": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "pathHint": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            }
          },
          "required": [
            "format",
            "id",
            "version",
            "pathHint"
          ],
          "additionalProperties": false
        },
        "engine": {
          "$ref": "#/$defs/NodeKey"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "maxItems": 256
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "maxItems": 256
        },
        "noteInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "noteOutputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "assets": {
          "type": "array",
          "maxItems": 65536,
          "description": "Sound assets the plugin's state uses: dependencies, never copied into the Performance",
          "items": {
            "type": "object",
            "properties": {
              "library": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "library",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "name",
        "plugin",
        "engine",
        "inputs",
        "outputs",
        "noteInputs",
        "noteOutputs"
      ],
      "additionalProperties": false
    },
    "Wire": {
      "description": "A wire between two nodes (RFC 0011). Audio wires join ports by stable port ID; 4294967294 marks a main port a plugin replacement could not map, 4294967295 a port it could not map at all. Empty channels apply the channel rules.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "audio",
            "notes"
          ]
        },
        "owner": {
          "enum": [
            "part",
            "user"
          ]
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "The part that made it; only for part wires"
        },
        "from": {
          "$ref": "#/$defs/EndpointKey"
        },
        "to": {
          "$ref": "#/$defs/EndpointKey"
        },
        "fromPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "toPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "channels": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "owner",
        "from",
        "to",
        "fromPort",
        "toPort",
        "channels",
        "level",
        "pan",
        "mute",
        "solo"
      ],
      "if": {
        "properties": {
          "owner": {
            "const": "part"
          }
        }
      },
      "then": {
        "required": [
          "part"
        ]
      },
      "else": {
        "not": {
          "required": [
            "part"
          ]
        }
      },
      "additionalProperties": false
    },
    "Part": {
      "description": "An input, the chain of nodes it reaches, and the graph output port it plays to (RFC 0011).",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "notes",
                "audio",
                "none"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "port"
          ],
          "additionalProperties": false
        },
        "chain": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/NodeKey"
          }
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "name",
        "input",
        "chain",
        "output"
      ],
      "additionalProperties": false
    }
  }
}
