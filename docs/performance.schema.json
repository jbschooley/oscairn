{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oscairn Performance version 11",
  "description": "performance.json inside a Performance folder. See performance-format.md for binary state, asset limits, plugin validation and transactional loading. Runtime node/context IDs and live voices are not persisted. Wires and parts (RFC 0011) define the graph's audio routes and note connections.",
  "type": "object",
  "properties": {
    "format": {
      "const": "oscairn.performance"
    },
    "version": {
      "const": 11
    },
    "info": {
      "type": "object",
      "description": "What the library shows (RFC 0021): an ID made at the first save and kept by every later one, a name, a description, free tags and a color",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "color": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{6})?$",
          "description": "#rrggbb, or empty for none"
        },
        "revision": {
          "type": "string",
          "maxLength": 64,
          "description": "This save's revision, made at each save"
        },
        "parent": {
          "type": "string",
          "maxLength": 64,
          "description": "The revision this one was saved over; empty for the first"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the contents: the document without its info block, then each nodes/ file by path with its own SHA-256 (RFC 0021). Not an identifier"
        },
        "origin": {
          "description": "For an item imported into the user's own storage (RFC 0021): the library it came from, its ID there, and this copy's content hash as imported, so importing again skips it while unchanged; null otherwise",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "library": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "item": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "library",
                "item",
                "hash"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "tags",
        "color",
        "revision",
        "parent",
        "hash",
        "origin"
      ],
      "additionalProperties": false
    },
    "libraries": {
      "type": "array",
      "maxItems": 4096,
      "description": "Asset libraries the nodes' sound assets come from (RFC 0009)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "transport": {
      "type": "object",
      "properties": {
        "tempo": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "clockSource": {
          "enum": [
            "internal",
            "midi"
          ]
        }
      },
      "required": [
        "tempo",
        "clockSource"
      ],
      "additionalProperties": false
    },
    "audioInputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      },
      "maxItems": 256
    },
    "audioOutputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      },
      "maxItems": 256
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 256
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Wire"
      },
      "maxItems": 4096
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      },
      "maxItems": 256
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/$defs/NodeKey"
          },
          "lane": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "to": {
            "$ref": "#/$defs/NodeKey"
          },
          "param": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "required": [
          "from",
          "lane",
          "to",
          "param"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "pads": {
      "$ref": "#/$defs/PadMap"
    },
    "key": {
      "$ref": "#/$defs/Key"
    },
    "scenes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/Scene"
      }
    },
    "sceneUntouched": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/SceneParameter"
      },
      "description": "The plugin parameters scenes never touch; they touch every other automatable one"
    },
    "scene": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "The scene last selected or stored, or 0"
    },
    "controls": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/Control"
      }
    },
    "assignments": {
      "type": "array",
      "maxItems": 4096,
      "description": "Physical controls' overrides (RFC 0011), by the control's logical identity, numbered across a device's assign groups (an external controller's after the device's own), and each part's Sound's own assignments; each control at most once per part (0 the Performance)",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "control": {
                "$ref": "#/$defs/PhysicalControl"
              },
              "kind": {
                "const": "parameter"
              },
              "node": {
                "$ref": "#/$defs/NodeKey"
              },
              "param": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "part": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295,
                "description": "0: the Performance's override; else that part's Sound's own assignment (parameter or control kinds only)"
              }
            },
            "required": [
              "control",
              "kind",
              "node",
              "param",
              "part"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "control": {
                "$ref": "#/$defs/PhysicalControl"
              },
              "kind": {
                "enum": [
                  "control",
                  "partLevel",
                  "partMute",
                  "scene"
                ]
              },
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295,
                "description": "The control, part or scene"
              },
              "part": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295,
                "description": "0: the Performance's override; else that part's Sound's own assignment (parameter or control kinds only)"
              }
            },
            "required": [
              "control",
              "kind",
              "id",
              "part"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "lock": {
      "type": "object",
      "description": "The plugin builds it was saved with (RFC 0006): for each plugin and platform, the build's digest, so an archive or a device can tell it has exactly that build",
      "properties": {
        "plugins": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "clap",
                  "lv2"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "platform": {
                "type": "string",
                "minLength": 1,
                "description": "Operating system and CPU, such as macos-arm64 or linux-arm64"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "The build's digest: a file's SHA-256, or for a bundle the SHA-256 of each file's path and SHA-256 in path order, hidden files left out"
              }
            },
            "required": [
              "format",
              "id",
              "version",
              "platform",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "plugins"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "info",
    "transport",
    "audioInputs",
    "audioOutputs",
    "nodes",
    "wires",
    "parts",
    "mappings",
    "pads",
    "key",
    "scenes",
    "sceneUntouched",
    "scene",
    "controls",
    "assignments",
    "lock"
  ],
  "additionalProperties": false,
  "$defs": {
    "PhysicalControl": {
      "type": "string",
      "pattern": "^(knob|fader|button|wheel|strip|jog|pedal|footswitch):[1-9][0-9]{0,2}$"
    },
    "NodeKey": {
      "type": "string",
      "pattern": "^node-[0-9]{1,7}$"
    },
    "EndpointKey": {
      "oneOf": [
        {
          "$ref": "#/$defs/NodeKey"
        },
        {
          "enum": [
            "input",
            "output"
          ]
        }
      ]
    },
    "Port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "channels",
        "flags"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/NodeKey"
        },
        "name": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "plugin": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "clap",
                "lv2"
              ]
            },
            "id": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "pathHint": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            }
          },
          "required": [
            "format",
            "id",
            "version",
            "pathHint"
          ],
          "additionalProperties": false
        },
        "engine": {
          "$ref": "#/$defs/NodeKey"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "maxItems": 256
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "maxItems": 256
        },
        "noteInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "noteOutputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "assets": {
          "type": "array",
          "maxItems": 65536,
          "description": "Sound assets the plugin's state uses: dependencies, never copied into the Performance",
          "items": {
            "type": "object",
            "properties": {
              "library": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "library",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "enabled": {
          "type": "boolean",
          "description": "false: switched off (RFC 0011 scenes): it takes no notes and no sound, and a part passes what reaches it around it"
        }
      },
      "required": [
        "key",
        "name",
        "plugin",
        "engine",
        "inputs",
        "outputs",
        "noteInputs",
        "noteOutputs",
        "enabled"
      ],
      "additionalProperties": false
    },
    "Wire": {
      "description": "A wire between two nodes (RFC 0011). Audio wires join ports by stable port ID; 4294967294 marks a main port a plugin replacement could not map, 4294967295 a port it could not map at all. Empty channels apply the channel rules. Note wires may carry zones; audio wires have none.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "audio",
            "notes"
          ]
        },
        "owner": {
          "enum": [
            "part",
            "user"
          ]
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "The part that made it; only for part wires"
        },
        "from": {
          "$ref": "#/$defs/EndpointKey"
        },
        "to": {
          "$ref": "#/$defs/EndpointKey"
        },
        "fromPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "toPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "channels": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "zones": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Zone"
          }
        },
        "send": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "For a part's send wire, the bus it sends to; otherwise 0"
        },
        "split": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "A part wire joining from a split's lane, or entering one in a bus: that split's ID, or 0. Its Mix is the lane's"
        },
        "lane": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "That lane's index"
        },
        "fader": {
          "type": "boolean",
          "description": "A part's wire to where it plays, carrying its level and mute"
        },
        "enabled": {
          "type": "boolean",
          "description": "false: switched off: a note wire takes no new notes, an audio wire is silent"
        }
      },
      "required": [
        "kind",
        "owner",
        "from",
        "to",
        "fromPort",
        "toPort",
        "channels",
        "level",
        "pan",
        "mute",
        "solo",
        "zones",
        "send",
        "split",
        "lane",
        "fader",
        "enabled"
      ],
      "if": {
        "properties": {
          "owner": {
            "const": "part"
          }
        }
      },
      "then": {
        "required": [
          "part"
        ]
      },
      "else": {
        "not": {
          "required": [
            "part"
          ]
        }
      },
      "additionalProperties": false
    },
    "Part": {
      "description": "An input, the chain of nodes it reaches, and the graph output port it plays to (RFC 0011).",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "notes",
                "audio",
                "none",
                "bus"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "zones": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/Zone"
              }
            },
            "devices": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/DeviceRule"
              },
              "description": "Which MIDI inputs play the part (RFC 0012); none: all"
            },
            "maxNotes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128,
              "description": "Notes at once (RFC 0018); past it, the oldest released note is choked, then the oldest held one. 0: no limit"
            }
          },
          "required": [
            "kind",
            "port",
            "zones",
            "devices",
            "maxNotes"
          ],
          "additionalProperties": false
        },
        "chain": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ChainEntry"
          }
        },
        "splits": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Split"
          }
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "The bus it plays through instead of its output port, or 0"
        },
        "sends": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "bus": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "level": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "bus",
              "level"
            ],
            "additionalProperties": false
          }
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "description": "Its fader; sends are post-fader"
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Where it plays, -1 left to 1 right; its sends keep their own"
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean",
          "description": "While any part is soloed, only soloed parts, the parts feeding them and the buses they feed are heard"
        },
        "midiOut": {
          "type": "object",
          "properties": {
            "devices": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/DeviceRule"
              },
              "description": "The MIDI outputs the part's MIDI goes to (RFC 0012 step 1), as selectors resolved on the device that opens it; none: no output"
            },
            "channel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16,
              "description": "1 to 16; 0 keeps each message's own channel"
            }
          },
          "required": [
            "devices",
            "channel"
          ],
          "additionalProperties": false
        },
        "from": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "sound": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "modified": {
                  "type": "boolean"
                }
              },
              "required": [
                "sound",
                "revision",
                "name",
                "modified"
              ],
              "additionalProperties": false
            }
          ],
          "description": "The library Sound and revision the part was loaded from (RFC 0021), and whether it has been edited since; null when none"
        },
        "key": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Key"
            }
          ],
          "description": "The part's own key and scale (RFC 0033); null follows the Performance's"
        }
      },
      "required": [
        "id",
        "name",
        "input",
        "chain",
        "splits",
        "output",
        "bus",
        "sends",
        "level",
        "pan",
        "mute",
        "solo",
        "midiOut",
        "key",
        "from"
      ],
      "additionalProperties": false
    },
    "Key": {
      "description": "Which notes belong to the key (RFC 0033), not tuning: a root, 0 (C) to 11 (B), and the scale's pitch classes in semitones above it, ascending from 0",
      "type": "object",
      "properties": {
        "root": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "scale": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "prefixItems": [
            {
              "const": 0
            }
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "uniqueItems": true
        }
      },
      "required": [
        "root",
        "scale"
      ],
      "additionalProperties": false
    },
    "Zone": {
      "description": "A note zone (RFC 0011): notes in its key, velocity and MIDI channel ranges pass, transposed and with velocity out = in^curve, or a fixed velocity above 0.",
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "velocities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "transpose": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127
        },
        "curve": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        },
        "fixedVelocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
