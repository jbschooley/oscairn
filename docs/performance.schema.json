{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oscairn Performance version 2",
  "description": "performance.json inside a Performance folder. See performance-format.md for binary state, asset limits, plugin validation and transactional loading. Runtime node/context IDs and live voices are not persisted. Wires and parts (RFC 0011) define the graph's audio routes and note connections.",
  "type": "object",
  "properties": {
    "format": {
      "const": "oscairn.performance"
    },
    "version": {
      "const": 2
    },
    "libraries": {
      "type": "array",
      "maxItems": 4096,
      "description": "Asset libraries the nodes' sound assets come from (RFC 0009)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "transport": {
      "type": "object",
      "properties": {
        "tempo": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "clockSource": {
          "enum": [
            "internal",
            "midi"
          ]
        }
      },
      "required": [
        "tempo",
        "clockSource"
      ],
      "additionalProperties": false
    },
    "audioInputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      },
      "maxItems": 256
    },
    "audioOutputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      },
      "maxItems": 256
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 256
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Wire"
      },
      "maxItems": 4096
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      },
      "maxItems": 256
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/$defs/NodeKey"
          },
          "lane": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "to": {
            "$ref": "#/$defs/NodeKey"
          },
          "param": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "required": [
          "from",
          "lane",
          "to",
          "param"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "pads": {
      "$ref": "#/$defs/PadMap"
    },
    "scenes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/Scene"
      }
    },
    "sceneParameters": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/SceneParameter"
      }
    },
    "scene": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "The scene last selected or stored, or 0"
    },
    "controls": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/Control"
      }
    }
  },
  "required": [
    "format",
    "version",
    "transport",
    "audioInputs",
    "audioOutputs",
    "nodes",
    "wires",
    "parts",
    "mappings",
    "pads",
    "scenes",
    "sceneParameters",
    "scene",
    "controls"
  ],
  "additionalProperties": false,
  "$defs": {
    "NodeKey": {
      "type": "string",
      "pattern": "^node-[0-9]{1,7}$"
    },
    "EndpointKey": {
      "oneOf": [
        {
          "$ref": "#/$defs/NodeKey"
        },
        {
          "enum": [
            "input",
            "output"
          ]
        }
      ]
    },
    "Port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "channels",
        "flags"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/NodeKey"
        },
        "name": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "plugin": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "clap",
                "lv2"
              ]
            },
            "id": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "pathHint": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            }
          },
          "required": [
            "format",
            "id",
            "version",
            "pathHint"
          ],
          "additionalProperties": false
        },
        "engine": {
          "$ref": "#/$defs/NodeKey"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "maxItems": 256
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "maxItems": 256
        },
        "noteInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "noteOutputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "assets": {
          "type": "array",
          "maxItems": 65536,
          "description": "Sound assets the plugin's state uses: dependencies, never copied into the Performance",
          "items": {
            "type": "object",
            "properties": {
              "library": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "library",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "name",
        "plugin",
        "engine",
        "inputs",
        "outputs",
        "noteInputs",
        "noteOutputs"
      ],
      "additionalProperties": false
    },
    "Wire": {
      "description": "A wire between two nodes (RFC 0011). Audio wires join ports by stable port ID; 4294967294 marks a main port a plugin replacement could not map, 4294967295 a port it could not map at all. Empty channels apply the channel rules. Note wires may carry zones; audio wires have none.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "audio",
            "notes"
          ]
        },
        "owner": {
          "enum": [
            "part",
            "user"
          ]
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "The part that made it; only for part wires"
        },
        "from": {
          "$ref": "#/$defs/EndpointKey"
        },
        "to": {
          "$ref": "#/$defs/EndpointKey"
        },
        "fromPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "toPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "channels": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "zones": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Zone"
          }
        },
        "send": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "For a part's send wire, the bus it sends to; otherwise 0"
        },
        "split": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "A part wire joining from a split's lane, or entering one in a bus: that split's ID, or 0. Its Mix is the lane's"
        },
        "lane": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "That lane's index"
        },
        "fader": {
          "type": "boolean",
          "description": "A part's wire to where it plays, carrying its level and mute"
        }
      },
      "required": [
        "kind",
        "owner",
        "from",
        "to",
        "fromPort",
        "toPort",
        "channels",
        "level",
        "pan",
        "mute",
        "solo",
        "zones",
        "send",
        "split",
        "lane",
        "fader"
      ],
      "if": {
        "properties": {
          "owner": {
            "const": "part"
          }
        }
      },
      "then": {
        "required": [
          "part"
        ]
      },
      "else": {
        "not": {
          "required": [
            "part"
          ]
        }
      },
      "additionalProperties": false
    },
    "Part": {
      "description": "An input, the chain of nodes it reaches, and the graph output port it plays to (RFC 0011).",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "notes",
                "audio",
                "none",
                "bus"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "zones": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/Zone"
              }
            },
            "devices": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/DeviceRule"
              },
              "description": "Which MIDI inputs play the part (RFC 0012); none: all"
            },
            "maxNotes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128,
              "description": "Notes at once (RFC 0018); past it, the oldest released note is choked, then the oldest held one. 0: no limit"
            }
          },
          "required": [
            "kind",
            "port",
            "zones",
            "devices",
            "maxNotes"
          ],
          "additionalProperties": false
        },
        "chain": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ChainEntry"
          }
        },
        "splits": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Split"
          }
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "The bus it plays through instead of its output port, or 0"
        },
        "sends": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "bus": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "level": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "bus",
              "level"
            ],
            "additionalProperties": false
          }
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "description": "Its fader; sends are post-fader"
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Where it plays, -1 left to 1 right; its sends keep their own"
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean",
          "description": "While any part is soloed, only soloed parts, the parts feeding them and the buses they feed are heard"
        }
      },
      "required": [
        "id",
        "name",
        "input",
        "chain",
        "splits",
        "output",
        "bus",
        "sends",
        "level",
        "pan",
        "mute",
        "solo"
      ],
      "additionalProperties": false
    },
    "Zone": {
      "description": "A note zone (RFC 0011): notes in its key, velocity and MIDI channel ranges pass, transposed and with velocity out = in^curve, or a fixed velocity above 0.",
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "velocities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "transpose": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127
        },
        "curve": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        },
        "fixedVelocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "keys",
        "velocities",
        "channels",
        "transpose",
        "curve",
        "fixedVelocity"
      ]
    },
    "Pad": {
      "type": "object",
      "properties": {
        "note": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "channel": {
          "type": "integer",
          "minimum": -1,
          "maximum": 15,
          "description": "-1: the channel the player is on"
        },
        "velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0: as played"
        },
        "pressure": {
          "enum": [
            "none",
            "poly",
            "channel"
          ]
        }
      },
      "required": [
        "note",
        "channel",
        "velocity",
        "pressure"
      ],
      "additionalProperties": false
    },
    "PadMap": {
      "description": "Which note each pad plays: eight banks (A..H) of 16 pads from the bottom-left, row by row.",
      "type": "object",
      "properties": {
        "bank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "banks": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/Pad"
            }
          }
        }
      },
      "required": [
        "bank",
        "banks"
      ],
      "additionalProperties": false
    },
    "Scene": {
      "description": "A scene: each part's fader and each scene parameter's value.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "part": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "level": {
                "type": "number",
                "minimum": 0
              },
              "mute": {
                "type": "boolean"
              }
            },
            "required": [
              "part",
              "level",
              "mute"
            ],
            "additionalProperties": false
          }
        },
        "values": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "node": {
                "$ref": "#/$defs/NodeKey"
              },
              "param": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "node",
              "param",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "control": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "control",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "parts",
        "values",
        "controls"
      ],
      "additionalProperties": false
    },
    "SceneParameter": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/NodeKey"
        },
        "param": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "node",
        "param"
      ],
      "additionalProperties": false
    },
    "ControlTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "parameter",
            "partLevel",
            "partMute",
            "control"
          ]
        },
        "node": {
          "$ref": "#/$defs/NodeKey"
        },
        "param": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "control": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "curve": {
          "enum": [
            "linear",
            "exponential",
            "logarithmic",
            "s-curve"
          ]
        },
        "relative": {
          "type": "boolean"
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "start",
        "end",
        "curve",
        "relative",
        "base"
      ],
      "additionalProperties": false
    },
    "Control": {
      "description": "A control of the control tree (RFC 0011): a value from 0 to 1 driving its targets, each with its own range and curve.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "targets": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/ControlTarget"
          }
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "targets"
      ],
      "additionalProperties": false
    },
    "DeviceRule": {
      "type": "object",
      "description": "RFC 0012 device selector rule: which MIDI inputs play a part. builtIn includes the panel's own notes; names match ignoring case.",
      "properties": {
        "kind": {
          "enum": [
            "builtIn",
            "external",
            "all",
            "port",
            "usb",
            "usbNamed",
            "network"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "For port: the DIN or TRS port number"
        },
        "pattern": {
          "type": "string",
          "maxLength": 256,
          "description": "For usbNamed (required) and network (optional): the name to match"
        },
        "match": {
          "enum": [
            "equals",
            "contains",
            "regex"
          ],
          "description": "How pattern matches a name; regex is ECMAScript"
        }
      },
      "required": [
        "kind",
        "port",
        "pattern",
        "match"
      ],
      "additionalProperties": false
    },
    "ChainEntry": {
      "description": "A chain entry: a node key, or a split",
      "oneOf": [
        {
          "$ref": "#/$defs/NodeKey"
        },
        {
          "type": "object",
          "properties": {
            "split": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "split"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Lane": {
      "type": "object",
      "description": "A split's lane (RFC 0011 step 3): its own chain, the notes it takes, and its row in the join's Mix",
      "properties": {
        "chain": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/ChainEntry"
          }
        },
        "zones": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Zone"
          }
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean",
          "description": "Silences the split's other lanes"
        }
      },
      "required": [
        "chain",
        "zones",
        "level",
        "pan",
        "mute",
        "solo"
      ],
      "additionalProperties": false
    },
    "Split": {
      "type": "object",
