{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oscairn theme version 4 (theme.json inside a theme folder)",
  "type": "object",
  "properties": {
    "version": {
      "const": 5
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "font": {
      "type": "object",
      "properties": {
        "regular": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "maxLength": 128,
          "description": "TrueType/OpenType font for regular text, at most 4 MiB"
        },
        "bold": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "maxLength": 128,
          "description": "Optional bold font, at most 4 MiB"
        },
        "license": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "maxLength": 128,
          "description": "The font's license text, at most 64 KiB"
        }
      },
      "required": [
        "regular",
        "license"
      ],
      "additionalProperties": false
    },
    "fontScale": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.4
    },
    "radius": {
      "type": "number",
      "minimum": 0,
      "maximum": 16
    },
    "colors": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "raised": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "positive": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "danger": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "background",
        "surface",
        "raised",
        "border",
        "text",
        "muted",
        "accent",
        "positive",
        "danger"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "description": "How controls are drawn: one choice each",
      "properties": {
        "buttons": {
          "enum": [
            "rounded",
            "pill"
          ]
        },
        "edges": {
          "enum": [
            "none",
            "hairline",
            "outlined"
          ]
        },
        "depth": {
          "enum": [
            "flat",
            "soft"
          ]
        },
        "sliders": {
          "enum": [
            "filled",
            "line",
            "cap"
          ]
        },
        "tabs": {
          "enum": [
            "folder",
            "segmented"
          ]
        },
        "marks": {
          "enum": [
            "square",
            "round"
          ]
        },
        "sections": {
          "enum": [
            "separate",
            "joined"
          ]
        }
      },
      "required": [
        "buttons",
        "edges",
        "depth",
        "sliders",
        "tabs",
        "marks",
        "sections"
      ],
      "additionalProperties": false
    },
    "wires": {
      "type": "object",
      "description": "Wires in the routing views: enabled audio and note wires, disabled ones, draining ones (seamless changes) and ones that no longer fit their ports",
      "properties": {
        "audio": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "notes": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "disabled": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "draining": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "unconnected": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "audio",
        "notes",
        "disabled",
        "draining",
        "unconnected"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "name",
    "font",
    "colors",
    "style",
    "wires"
  ],
  "additionalProperties": false
}
