{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oscairn device and controller profile version 2",
  "description": "One product Oscairn runs on (RFC 0024): read by the app and the engine instead of flags; or an external MIDI controller (it names midi.ports), whose controls join a device's while connected. Values in sections listed in estimated are estimates, not measured on a unit.",
  "type": "object",
  "properties": {
    "format": {
      "const": "oscairn.profile"
    },
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+$",
      "maxLength": 256
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "board": {
          "type": "string"
        }
      },
      "required": [
        "os",
        "cpu"
      ],
      "additionalProperties": false
    },
    "compute": {
      "type": "object",
      "description": "memory and storage in MiB",
      "properties": {
        "cores": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "realtimeCores": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "memory": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "storage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "osMemory": {
          "type": "integer",
          "description": "RFC 0025: what the operating system and everything beside Oscairn need at their peak; with performanceMemory or not at all",
          "minimum": 0,
          "maximum": 16777216
        },
        "performanceMemory": {
          "type": "integer",
          "description": "RFC 0025: the floor for Performances, committed memory no app launch may take; with osMemory or not at all",
          "minimum": 0,
          "maximum": 16777216
        }
      },
      "dependentRequired": {
        "osMemory": [
          "performanceMemory"
        ],
        "performanceMemory": [
          "osMemory"
        ]
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "outputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 8000,
            "maximum": 384000
          }
        },
        "block": {
          "description": "Frames the audio device is asked for; 0 or absent: the build's default",
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192
            }
          ]
        },
        "headphones": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "keys",
              "pads",
              "encoders",
              "knobs",
              "faders",
              "buttons",
              "pedal",
              "footswitches",
              "expression",
              "jog",
              "touchstrip",
              "wheels"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "sensing": {
            "type": "string"
          },
          "role": {
            "enum": [
              "notes",
              "screen",
              "assign",
              "fixed"
            ],
            "description": "notes: keys and pads, and only they; screen: plays what the screen shows; assign: plays banks; fixed: a dedicated function each"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "description": "An assign group of knobs: hardware rows, each a bank its row button picks, named on screen",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "bank": {
                  "enum": [
                    "assign",
                    "filter",
                    "ampEG",
                    "eq",
                    "levels",
                    "effects"
                  ]
                }
              },
              "required": [
                "name",
                "bank"
              ],
              "additionalProperties": false
            }
          },
          "paging": {
            "enum": [
              "button",
              "screen"
            ],
            "description": "An assign group of knobs without rows: what pages its banks"
          },
          "modes": {
            "type": "array",
            "maxItems": 64,
            "description": "Faders only: what they play by mode",
            "items": {
              "enum": [
                "part",
                "element",
                "audio"
              ]
            }
          },
          "functions": {
            "type": "array",
            "maxItems": 64,
            "description": "A fixed group: each control's function, one per control. An assign group of wheels, a touchstrip, pedals, expression pedals, footswitches or a jog: the standard controller each passes to every part when nothing is assigned",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "target": {
            "enum": [
              "banks",
              "partLevels",
              "partMutes",
              "scenes"
            ],
            "description": "An assign group's default target: banks for knobs and encoders, partLevels for faders, partMutes (the default) or scenes for buttons"
          },
          "midi": {
            "type": "object",
            "description": "A controller's control group: how it talks MIDI",
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16,
                "description": "Which of midi.ports, from 1; a midi port, not an ignored one"
              },
              "channel": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Channel"
                  },
                  {
                    "type": "array",
                    "maxItems": 1024,
                    "items": {
                      "$ref": "#/$defs/Channel"
                    }
                  }
                ],
                "description": "For the group, or one per control"
              },
              "cc": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "description": "A controller number per control, or per control per row for rows whose switch changes the numbers"
              },
              "notes": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "description": "A note number per control"
              },
              "pitchBend": {
                "type": "boolean",
                "description": "A group of one wheel sending pitch bend"
              },
              "encoding": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Encoding"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Encoding"
                    }
                  }
                ],
                "description": "With cc: for the group, or one per control; absolute when absent"
              },
              "button": {
                "enum": [
                  "momentary",
                  "latch"
                ],
                "description": "Buttons: momentary (each press toggles or selects) or latch (the controller keeps the state)"
              },
              "feedback": {
                "type": "boolean",
                "description": "The controller takes each control's value back on its CC, so an endless knob sending absolute values matches its target without pickup; absolute CCs only; off when absent, and until a unit confirms it"
              }
            },
            "required": [
              "channel"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "count",
          "role"
        ],
        "additionalProperties": false,
        "description": "A group of physical controls of one kind doing one job (RFC 0024's control groups, RFC 0011's physical controls)",
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "keys",
                    "pads"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "const": "notes"
                }
              }
            },
            "else": {
              "properties": {
                "role": {
                  "enum": [
                    "screen",
                    "assign",
                    "fixed"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "assign"
                },
                "kind": {
                  "enum": [
                    "knobs",
                    "encoders"
                  ]
                }
              }
            },
            "then": {
              "oneOf": [
                {
                  "required": [
                    "rows"
                  ],
                  "not": {
                    "required": [
                      "paging"
                    ]
                  }
                },
                {
                  "required": [
                    "paging"
                  ],
                  "not": {
                    "required": [
                      "rows"
                    ]
                  }
                }
              ]
            },
            "else": {
              "if": {
                "properties": {
                  "role": {
                    "const": "assign"
                  },
                  "kind": {
                    "not": {
                      "enum": [
                        "faders",
                        "buttons"
                      ]
                    }
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "rows",
                    "paging"
                  ]
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "rows"
                      ]
                    },
                    {
                      "required": [
                        "paging"
                      ]
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "kind": {
                    "const": "faders"
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "modes"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "notes",
                    "screen"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "functions"
                ]
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "role": {
                    "const": "assign"
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "target"
                ]
              }
            }
          }
        ]
      }
    },
    "screens": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "touch": {
            "type": "boolean"
          },
          "surface": {
            "enum": [
              "desktop",
              "panel",
              "compact"
            ]
          },
          "layout": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "width",
          "height",
          "surface",
          "layout"
        ],
        "additionalProperties": false
      }
    },
    "midi": {
      "type": "object",
      "properties": {
        "din": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "usbDevice": {
          "type": "boolean"
        },
        "usbHost": {
          "type": "boolean"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "description": "A controller's MIDI input ports; a profile with ports is a controller's",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Matches an input whose name contains it, ignoring case"
              },
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64,
                "description": "The Nth matching input, in the system's order; 1 when absent"
              },
              "protocol": {
                "enum": [
                  "midi",
                  "mackie"
                ],
                "description": "midi (the default), or mackie: Mackie Control (transport, the strips' select, mute, solo and faders, V-pots, cursors and jog wheel), with LEDs and faders sent back on the output of the same name"
              },
              "ignore": {
                "type": "boolean",
                "description": "A port that duplicates another's messages: the engine leaves its input out, so nothing plays twice. Has no protocol"
              },
              "display": {
                "type": "boolean",
                "description": "A Mackie surface with scribble strips: the parts' names are sent to them. Mackie ports only; false when absent"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cv": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "outputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "ethernet": {
          "type": "boolean"
        },
        "wifi": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "power": {
      "type": "object",
      "properties": {
        "battery": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "reliability": {
      "enum": [
        "desktop",
        "instrument",
        "pass-through"
      ],
      "description": "RFC 0027's level"
    },
    "apps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "alwaysAvailable": {
      "type": "array",
      "description": "RFC 0025: the apps reserved whether they run or not, each in apps; absent: oscairn.performance and oscairn.library where apps lists them",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "estimated": {
      "type": "array",
      "items": {
        "enum": [
          "platform",
          "compute",
          "audio",
          "controls",
          "screens",
          "midi",
          "cv",
          "network",
          "power"
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "Channel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "Encoding": {
      "anyOf": [
        {
          "enum": [
            "absolute",
            "twosComplement",
            "binaryOffset",
            "signMagnitude"
          ]
        },
        {
          "type": "object",
          "description": "Explicit steps: the value sent for one step up and the value for one step down, which differ; any other value is no step",
          "properties": {
            "increment": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "decrement": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          },
          "required": [
            "increment",
            "decrement"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "midi": {
            "required": [
              "ports"
            ]
          }
        },
        "required": [
          "midi"
        ]
      },
      "then": {
        "properties": {
          "midi": {
            "properties": {
              "din": false,
              "usbDevice": false,
              "usbHost": false
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "platform"
              ]
            },
            {
              "required": [
                "compute"
              ]
            },
            {
              "required": [
                "audio"
              ]
            },
            {
              "required": [
                "screens"
              ]
            },
            {
              "required": [
                "cv"
              ]
            },
            {
              "required": [
                "network"
              ]
            },
            {
              "required": [
                "power"
              ]
            },
            {
              "required": [
                "reliability"
              ]
            },
            {
              "required": [
                "apps"
              ]
            },
            {
              "required": [
                "alwaysAvailable"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "reliability"
        ]
      }
    }
  ]
}
