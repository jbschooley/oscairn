{
  "version": 6,
  "id": "oscairn-light",
  "name": "Oscairn Light",
  "font": {
    "regular": "fonts/Inter-Regular.ttf",
    "bold": "fonts/Inter-Bold.ttf",
    "license": "fonts/OFL.txt"
  },
  "fontScale": 1.0,
  "radius": 6,
  "colors": {
    "background": "#EEF1F5",
    "surface": "#FFFFFF",
    "raised": "#DFE4EA",
    "border": "#A9B4C1",
    "text": "#10161E",
    "muted": "#4F5B69",
    "accent": "#B85A0A",
    "positive": "#00744F",
    "danger": "#C42D2D"
  },
  "style": {
    "buttons": "pill",
    "edges": "hairline",
    "depth": "soft",
    "sliders": "line",
    "tabs": "segmented",
    "marks": "square",
    "sections": "separate",
    "rows": "left"
  },
  "wires": {
    "audio": "#2F6FD0",
    "notes": "#7B4BD6",
    "disabled": "#9AA3AD",
    "draining": "#B85A0A",
    "unconnected": "#C42D2D"
  }
}
