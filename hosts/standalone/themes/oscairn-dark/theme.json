{
  "version": 5,
  "id": "oscairn-dark",
  "name": "Oscairn Dark",
  "font": {
    "regular": "fonts/Inter-Regular.ttf",
    "bold": "fonts/Inter-Bold.ttf",
    "license": "fonts/OFL.txt"
  },
  "fontScale": 1.0,
  "radius": 6,
  "colors": {
    "background": "#111317",
    "surface": "#1D2127",
    "raised": "#2D333B",
    "border": "#4A535E",
    "text": "#F6F8FA",
    "muted": "#B4BDC8",
    "accent": "#FF9A45",
    "positive": "#5AD9A4",
    "danger": "#FF6B63"
  },
  "style": {
    "buttons": "pill",
    "edges": "hairline",
    "depth": "soft",
    "sliders": "line",
    "tabs": "segmented",
    "marks": "square",
    "sections": "separate"
  },
  "wires": {
    "audio": "#8CC2FF",
    "notes": "#C29CFF",
    "disabled": "#6B7480",
    "draining": "#FF9A45",
    "unconnected": "#FF6B63"
  }
}
