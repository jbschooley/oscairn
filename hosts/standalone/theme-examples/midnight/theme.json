{
  "version": 4,
  "id": "midnight",
  "name": "Midnight",
  "font": {
    "regular": "fonts/Inter-Regular.ttf",
    "bold": "fonts/Inter-Bold.ttf",
    "license": "fonts/OFL.txt"
  },
  "fontScale": 1.0,
  "radius": 8,
  "colours": {
    "background": "#101724",
    "surface": "#172439",
    "raised": "#24354C",
    "border": "#637B97",
    "text": "#F0F5FC",
    "muted": "#A9BBD1",
    "accent": "#7CCEFF",
    "positive": "#7DDEB2",
    "danger": "#FF9994"
  },
  "style": {
    "buttons": "pill",
    "edges": "hairline",
    "depth": "soft",
    "sliders": "line",
    "tabs": "segmented",
    "marks": "square",
    "sections": "separate"
  },
  "wires": {
    "audio": "#7CCEFF",
    "notes": "#C9A4FF",
    "disabled": "#5F7189",
    "draining": "#FFB86B",
    "unconnected": "#FF9994"
  }
}
