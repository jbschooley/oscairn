#!/bin/sh
# Starts the Oscairn session at boot: the X server and the app, full screen.

PIDFILE=/var/run/oscairn-session.pid

case "$1" in
start)
	printf "Starting Oscairn: "
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/libexec/oscairn-session && echo "OK" || echo "FAIL"
	;;
stop)
	printf "Stopping Oscairn: "
	start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE"
	killall Oscairn Xorg 2>/dev/null
	echo "OK"
	;;
restart)
	"$0" stop
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
