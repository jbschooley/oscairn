 [a lv2:OutputPort, lv2:ControlPort; lv2:index 5; lv2:symbol "tempo"; lv2:name "Tempo"; lv2:minimum 0; lv2:maximum 1000; lv2:default 0],
 [a lv2:OutputPort, lv2:ControlPort; lv2:index 6; lv2:symbol "frame"; lv2:name "Frame"; lv2:minimum 0; lv2:maximum 1000000; lv2:default 0],
 [a lv2:OutputPort, lv2:ControlPort; lv2:index 7; lv2:symbol "beat"; lv2:name "Beat"; lv2:minimum 0; lv2:maximum 1000000; lv2:default 0],
 [a lv2:InputPort, lv2:ControlPort; lv2:index 8; lv2:symbol "bad_output"; lv2:name "Bad Output"; lv2:minimum 0; lv2:maximum 3; lv2:default 0; lv2:portProperty lv2:integer]
 .

@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<urn:oscairn:test:state> patch:writable <urn:oscairn:test:value>, <urn:oscairn:test:text> .
<urn:oscairn:test:value> rdfs:range atom:Float; rdfs:label "Value" .
<urn:oscairn:test:text> rdfs:range atom:String; rdfs:label "Text" .
<urn:oscairn:test:preset> a pset:Preset; lv2:appliesTo <urn:oscairn:test:state>;
 rdfs:label "Double"; state:state [<urn:oscairn:test:value> "2.0"^^xsd:float];
 lv2:port [lv2:symbol "gain"; pset:value 0.75] .
<urn:oscairn:test:bad-preset> a pset:Preset; lv2:appliesTo <urn:oscairn:test:state>;
 rdfs:label "Rejected"; state:state [<urn:oscairn:test:value> "-1.0"^^xsd:float] .
